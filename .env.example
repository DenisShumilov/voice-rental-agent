# Template. Copy to .env and fill in the values there.
# .env is git-ignored; this file is committed, so it must never hold a real key.

# Database.
# Leave unset for local development — it defaults to file:./data/rental.db
# For production, point this at a Turso database:
#   DATABASE_URL=libsql://your-database.turso.io
#   DATABASE_AUTH_TOKEN=your-token
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# OpenAI. Needed from the voice block onwards.
# This key stays on the server: the browser only ever receives a short-lived
# ephemeral client secret minted from it.
OPENAI_API_KEY=
